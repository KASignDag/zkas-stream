# Public ZKas explorer REST backend used by the browser.
VITE_ZKAS_API_BASE=/zkas-api

# Poll interval in milliseconds.
VITE_POLL_MS=15000

# Server-only OTC trade-log connection. Configure these as encrypted Cloudflare
# environment variables; never prefix them with VITE_ or commit real values.
ZKAS_OTC_API_URL=
ZKAS_OTC_API_KEY=
ZKAS_OTC_API_HEADER=Authorization
ZKAS_OTC_API_PREFIX=Bearer

# Screenshot-import fallback. OTC_TRADES is a Cloudflare KV binding; the
# password must be added as an encrypted production secret.
OTC_IMPORT_SECRET=
